@misc{lu2026drivingoutsupply,
  abbr     = {Lu (2026)},
  title    = {Driving Out Supply: The Impact of Removing Minimum Parking Requirements on Housing},
  abstract = {Many cities in the US have eliminated minimum parking requirements (MPRs) as part of policy reforms aimed toward increasing housing supply, yet empirical research has primarily focused on the effects on parking instead. I quantify the causal effect of MPRs on housing supply by analyzing two MPR removals in Seattle in 2010 and 2011. Using a difference-in-differences estimator to leverage staggered within-city variation in treatment, I find that eliminating MPRs led to 20 more new multifamily housing units each year, per census block group on average. The MPR removals also operated along the extensive margin, increasing the likelihood of any new multifamily housing unit by 9\%. Housing supply effects exhibit heterogeneity, with the largest increases for transit-proximal and low-income block groups.},
  note     = {<i>Draft coming soon</i>},
  selected = {true}
}

